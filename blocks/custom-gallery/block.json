{
  "name": "acf/custom-gallery",
  "title": "Custom gallery",
  "description": "Works block.",
  "style": "file:../../dist/blocks/custom-gallery/style-index.css",
  "viewScript": "file:../../dist/blocks/custom-gallery/view.js",
  "category": "formatting",
  "icon": "admin-comments",
  "keywords": ["images", "gallery"],
  "acf": {
    "mode": "preview",
    "renderTemplate": "custom-gallery.php"
  },
  "supports": {
    "align": false,
    "anchor": true,
    "alignContent": true,
    "spacing": {
      "padding": true,
      "margin": true
    },
    "color": {
      "text": false,
      "background": true,
      "link": true
    },
    "alignText": false,
    "fullHeight": false
  },
  "attributes": {
    "backgroundColor": {
      "type": "string",
      "default": "tertiary"
    }
  }
}
